{
  "name": "teamwork-token-usage",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "团队 AI Token 用量看板：先个人、后团队",
  "scripts": {
    "dev": "TTU_SYNC=1 pnpm --parallel --filter @ttu/server --filter @ttu/web dev",
    "dev:server": "pnpm --filter @ttu/server dev",
    "dev:web": "pnpm --filter @ttu/web dev",
    "build": "pnpm --filter @ttu/web build",
    "bundle": "pnpm build && node scripts/build-bundle.mjs",
    "start": "pnpm --filter @ttu/server start",
    "test:collect": "node scripts/test-collectors.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ttu": "./bin/ttu.mjs"
  },
  "files": [
    "bin",
    "bundle",
    "README.md"
  ],
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
